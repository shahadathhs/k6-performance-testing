{
  "name": "k6-performance-testing",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript k6 load-testing scenarios — pnpm workspace, k6 binary pinned via Docker Compose",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/k6": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
